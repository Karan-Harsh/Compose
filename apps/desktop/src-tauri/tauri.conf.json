{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TypeFlow",
  "version": "0.1.0",
  "identifier": "com.typeflow.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TypeFlow",
        "width": 1120,
        "height": 760,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
